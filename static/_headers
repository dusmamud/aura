# Immutable hashed assets (Vite emits fingerprinted filenames under /_app/)
/_app/immutable/*:
  Cache-Control: public, max-age=31536000, immutable

# Images and fonts are content-addressed by name in this project; keep a long cache
/images/*:
  Cache-Control: public, max-age=31536000, immutable

# HTML is always revalidated
/*:
  Cache-Control: public, max-age=0, must-revalidate
